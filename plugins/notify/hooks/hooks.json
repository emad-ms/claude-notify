{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/notify.sh\"",
            "shell": "bash",
            "async": true
          },
          {
            "type": "command",
            "command": "& \"${CLAUDE_PLUGIN_ROOT}/scripts/notify.ps1\"",
            "shell": "powershell",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/notify.sh\"",
            "shell": "bash",
            "async": true
          },
          {
            "type": "command",
            "command": "& \"${CLAUDE_PLUGIN_ROOT}/scripts/notify.ps1\"",
            "shell": "powershell",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/permission.sh\"",
            "shell": "bash",
            "async": true
          },
          {
            "type": "command",
            "command": "& \"${CLAUDE_PLUGIN_ROOT}/scripts/permission.ps1\"",
            "shell": "powershell",
            "async": true
          }
        ]
      }
    ]
  }
}
